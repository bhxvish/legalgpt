# Copy to `.env` at the repo root and fill in. `.env` is git-ignored.
# Every variable read by backend/app/config.py is listed here.

# --- Secrets ---
# Groq API key (Llama-3 generation, Whisper). https://console.groq.com/keys
GROQ_API_KEY= 
# Hugging Face token (InLegalBERT, base models for LoRA). https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Storage paths (optional; defaults shown, relative paths resolve from the launch directory) ---
# Default: <repo>/data/chroma_db
CHROMA_PERSIST_DIR=
# Default: <repo>/data/raw_judgments (collected judgment texts + index.jsonl)
RAW_JUDGMENTS_DIR=
# Default: <repo>/data/annotation_store
ANNOTATION_STORE_DIR=
# Default: <repo>/backend/app/verification/rules
PROLOG_RULES_DIR=

# --- Module 0: retrieval & generation (optional; defaults shown) ---
# Groq chat model. Llama-3 is no longer served by Groq; gpt-oss-120b is the strongest available open-weight model.
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=ipc_bare_act
# Parsed IPC chunks, embedded into the index at startup when it is empty. Default: <repo>/data/corpus/ipc_chunks.jsonl
CORPUS_CHUNKS_PATH=
# Cosine-similarity floor; if no retrieved chunk clears it, Legal mode refuses instead of answering.
# 0.55 was calibrated with backend/scripts/calibrate_retrieval.py (MiniLM + IPC); re-run it if either changes.
RETRIEVAL_MIN_SIMILARITY=0.55

# --- Module 2: BERT-assisted annotation (optional; defaults shown) ---
# Where trained InLegalBERT checkpoints are saved. Default: <repo>/data/models/rrl
RRL_MODEL_DIR=
# Predictions below this confidence always go to human review
REVIEW_TAU_CONF=0.7
# Share of confident predictions sampled for an audit review
REVIEW_AUDIT_RATE=0.1
# If more than this share of audited predictions needed correction, the case is escalated to full manual review
REVIEW_MAX_AUDIT_ERROR=0.2

# --- Module 3: LoRA fine-tuning (optional; defaults shown) ---
# Chat model: groq (hosted) or adapter (local base model + LoRA adapter; run the backend from .venv-gpu)
LLM_BACKEND=groq
# Where LoRA adapters are saved. Default: <repo>/data/models/lora
LORA_DIR=
# Adapter to serve when LLM_BACKEND=adapter. Default: the newest adapter under LORA_DIR
ADAPTER_PATH=

# --- Module 4: explainability (optional; defaults shown) ---
# Evidence-match bands: how closely the retrieved text matches the question (NOT answer correctness)
EXPLAIN_BAND_HIGH=0.70
EXPLAIN_BAND_MEDIUM=0.60
# An answer sentence counts as supported when its best-matching source sentence reaches this similarity
EXPLAIN_SUPPORT_THRESHOLD=0.55

# --- Server ---
# Comma-separated origins allowed by CORS. Default: http://localhost:5173 (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Frontend (read by Vite, not config.py) ---
# Backend base URL the browser calls. Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# --- Docker only (read by docker compose, not config.py) ---
# Host Hugging Face cache to mount into the backend container instead of a fresh volume, e.g.
# C:/Users/<you>/.cache/huggingface. Empty: models download inside Docker (slow for the 3 GB Tuned model).
HF_CACHE_DIR=
