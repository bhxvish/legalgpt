# Copy to `.env` at the repo root and fill in. `.env` is git-ignored.
# Every variable read by backend/app/config.py is listed here.

# --- Secrets ---
# Groq API key (Llama-3 generation, Whisper). https://console.groq.com/keys
GROQ_API_KEY=
# Hugging Face token (InLegalBERT, base models for LoRA). https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Storage paths (optional; defaults shown, relative paths resolve from the launch directory) ---
# Default: <repo>/data/chroma_db
CHROMA_PERSIST_DIR=
# Default: <repo>/data/annotation_store
ANNOTATION_STORE_DIR=
# Default: <repo>/backend/app/verification/rules
PROLOG_RULES_DIR=

# --- Server ---
# Comma-separated origins allowed by CORS. Default: http://localhost:5173 (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Frontend (read by Vite, not config.py) ---
# Backend base URL the browser calls. Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
